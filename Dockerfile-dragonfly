#FROM docker.dragonflydb.io/dragonflydb/dragonfly:latest

FROM ubuntu:22.04

RUN apt update && apt install -y \
    ninja-build \
    libunwind-dev \
    libboost-context-dev \
    libssl-dev \
    autoconf-archive \
    libtool \
    cmake \
    g++ \
    bison \
    zlib1g-dev \
    patch \
    git

WORKDIR /opt/dragonfly

COPY dragonfly-main /opt/dragonfly

RUN ./helio/blaze.sh -release \
 && cd build-opt \
 && ninja dragonfly

EXPOSE 6381

